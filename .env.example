# Copy to .env and fill in. NEVER commit .env. Names only here — no values.

# Anthropic API key (the SDK reads this automatically; settings only assert presence).
ANTHROPIC_API_KEY=

# GitHub fine-grained PAT, scoped to the target repo: Contents=write, Pull requests=write.
# (Optional: Issues=write if you want the "qaia:generated" label applied — labeling is
#  best-effort and is skipped without it; the PR is still opened.)
GITHUB_TOKEN=

# Target repository for the opened PR, as "owner/repo" (set this when ready).
GITHUB_REPO=
